#!/bin/sh
# College WiFi Management System - UCI Defaults
# Phase 4: Adds session-timeout, portal config, openNDS integration keys
# Runs once on first installation; safe to re-run (idempotent).

# ── UCI configuration ─────────────────────────────────────────────────────
uci -q batch <<-EOF
	delete college-wifi.settings
	set college-wifi.settings=settings
	set college-wifi.settings.default_quota='1024'
	set college-wifi.settings.quota_unit='MB'
	set college-wifi.settings.portal_enabled='1'
	set college-wifi.settings.portal_url='http://192.168.1.1/portal'
	set college-wifi.settings.session_timeout='86400'
	set college-wifi.settings.check_interval='300'
	set college-wifi.settings.max_failed_attempts='5'
	set college-wifi.settings.lockout_window='900'
	set college-wifi.settings.opennds_enabled='0'
	set college-wifi.settings.opennds_fasport='2080'
	set college-wifi.settings.opennds_faspath='/cw-auth/portal.sh'
	set college-wifi.settings.opennds_faskey='CHANGE_THIS_IN_PRODUCTION'
	commit college-wifi
EOF

# ── Data directory ────────────────────────────────────────────────────────
mkdir -p /etc/college-wifi
chmod 700 /etc/college-wifi

# ── JSON database initialisation (only if files don't exist yet) ──────────
[ ! -f /etc/college-wifi/students.json ]      && echo '[]' > /etc/college-wifi/students.json
[ ! -f /etc/college-wifi/devices.json ]       && echo '[]' > /etc/college-wifi/devices.json
[ ! -f /etc/college-wifi/sessions.json ]      && echo '[]' > /etc/college-wifi/sessions.json
[ ! -f /etc/college-wifi/usage.json ]         && echo '[]' > /etc/college-wifi/usage.json
[ ! -f /etc/college-wifi/security_events.json ] && echo '[]' > /etc/college-wifi/security_events.json
[ ! -f /etc/college-wifi/failed_auth.json ]   && echo '{}' > /etc/college-wifi/failed_auth.json

chmod 600 /etc/college-wifi/*.json

# ── Portal web directory ──────────────────────────────────────────────────
mkdir -p /www/portal
chmod 755 /www/portal

# ── FAS handler directory ─────────────────────────────────────────────────
mkdir -p /usr/lib/college-wifi
chmod 755 /usr/lib/college-wifi

logger -t college-wifi "College WiFi Management System (Phase 4) initialized"

exit 0
