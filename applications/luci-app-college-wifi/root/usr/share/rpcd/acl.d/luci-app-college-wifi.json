{
	"luci-app-college-wifi": {
		"description": "Full administrator access to College WiFi Management System",
		"read": {
			"ubus": {
				"college.wifi": [
					"get_dashboard_stats",
					"get_students",
					"get_student",
					"list_devices",
					"get_device",
					"get_usage_stats",
					"get_security_events",
					"get_active_sessions"
				]
			},
			"uci": [ "college-wifi" ],
			"file": {
				"/etc/college-wifi/students.json":       [ "read" ],
				"/etc/college-wifi/security_events.json": [ "read" ],
				"/etc/college-wifi/devices.json":         [ "read" ],
				"/etc/college-wifi/sessions.json":        [ "read" ]
			}
		},
		"write": {
			"ubus": {
				"college.wifi": [
					"add_student",
					"update_student",
					"delete_student",
					"block_student",
					"unblock_student",
					"reset_quota",
					"block_device",
					"unblock_device"
				]
			},
			"uci": [ "college-wifi" ],
			"file": {
				"/etc/college-wifi/students.json":       [ "write" ],
				"/etc/college-wifi/security_events.json": [ "write" ],
				"/etc/college-wifi/devices.json":         [ "write" ],
				"/etc/college-wifi/sessions.json":        [ "write" ]
			}
		}
	},

	"luci-app-college-wifi-netadmin": {
		"description": "Network administrator — read monitoring, limited write",
		"read": {
			"ubus": {
				"college.wifi": [
					"get_dashboard_stats",
					"get_students",
					"list_devices",
					"get_device",
					"get_usage_stats",
					"get_active_sessions",
					"get_security_events"
				]
			},
			"uci": [ "college-wifi" ]
		},
		"write": {
			"ubus": {
				"college.wifi": [
					"block_device",
					"unblock_device"
				]
			}
		}
	},

	"luci-app-college-wifi-student": {
		"description": "Student portal access — personal data only",
		"read": {
			"ubus": {
				"college.wifi": [
					"get_my_quota",
					"get_my_usage",
					"get_my_devices"
				]
			}
		}
	}
}
